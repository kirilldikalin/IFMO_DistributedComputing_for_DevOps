docker_network_name: wp_network

db_image: mysql:5.7

db_cluster_primary_container_name: mysql_master
db_cluster_replica_container_name: mysql_replica
db_cluster_primary_port: 3306
db_cluster_replica_port: 3307
db_primary_volume: mysql_master_data
db_replica_volume: mysql_replica_data

db_primary_container: "{{ db_cluster_primary_container_name }}"
db_replica_container: "{{ db_cluster_replica_container_name }}"
db_cluster_primary_bind: "{{ db_cluster_primary_port }}:3306"
db_cluster_replica_bind: "{{ db_cluster_replica_port }}:3306"

wordpress_container_name: wordpress
wordpress_image: wordpress:6.6-apache
wordpress_port: 8080
wordpress_volume: wordpress_data
wordpress_db_user: "{{ wp_db_user | default('wpuser') }}"
wordpress_db_password: "{{ wp_db_password | default('wp_pass_local') }}"
wordpress_db_name: "{{ wp_db_name | default('wpdb') }}"
wordpress_db_host: "{{ db_primary_container }}"
wordpress_db_port: "{{ db_cluster_primary_port }}"

mysql_master_cnf:
  - "bind-address=0.0.0.0"
  - "server-id=1"
  - "expire_logs_days=7"
  - "log_bin=/var/lib/mysql/mysql-bin"
  - "binlog_format=ROW"
  - "explicit_defaults_for_timestamp=1"
  - "gtid_mode=ON"
  - "enforce_gtid_consistency=ON"

mysql_replica_cnf:
  - "relay_log_index=relay-bin.index"
  - "bind-address=0.0.0.0"
  - "server-id=2"
  - "relay_log=relay-bin"
  - "gtid_mode=ON"
  - "enforce_gtid_consistency=ON"
  - "log_slave_updates=ON"
  - "read_only=ON"
