- name: Ensure PyMySQL for MySQL modules
  ansible.builtin.apt:
    name: python3-pymysql
    state: present
    update_cache: true

- name: Ensure primary volume
  community.docker.docker_volume:
    name: "{{ db_primary_volume }}"
    state: present

- name: Ensure replica volume
  community.docker.docker_volume:
    name: "{{ db_replica_volume }}"
    state: present

- name: Ensure config dir for MariaDB
  ansible.builtin.file:
    path: /opt/wpdb
    state: directory
    mode: '0755'

- name: Write MariaDB PRIMARY config
  ansible.builtin.copy:
    dest: /opt/wpdb/primary.cnf
    mode: '0644'
    content: |
      [mysqld]
      server-id=1
      log-bin=mysql-bin
      binlog_format=ROW
      skip-slave-start=1

- name: Write MariaDB REPLICA config
  ansible.builtin.copy:
    dest: /opt/wpdb/replica.cnf
    mode: '0644'
    content: |
      [mysqld]
      server-id=2
      relay-log=relay-bin
      read_only=ON
      skip-slave-start=1
- name: Run MariaDB PRIMARY
  community.docker.docker_container:
    name: "{{ db_primary_container }}"
    image: "{{ db_image }}"
    state: started
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    volumes:
      - "{{ db_primary_volume }}:/var/lib/mysql"
    env:
      MARIADB_ROOT_PASSWORD: "{{ db_root_password }}"
      MARIADB_DATABASE: "{{ wordpress_db_name }}"
      MARIADB_USER: "{{ wordpress_db_user }}"
      MARIADB_PASSWORD: "{{ wordpress_db_password }}"
    command:
      - "--server-id=1"
      - "--log-bin=mysql-bin"
      - "--binlog-format=ROW"
      - "--skip-slave-start"
    published_ports:
      - "{{ db_cluster_primary_bind }}"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -p{{ db_root_password }} || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

- name: Wait PRIMARY healthy
  community.docker.docker_container_info:
    name: "{{ db_primary_container }}"
  register: db_cluster_primary_info
  until: db_cluster_primary_info.container.State.Health.Status is defined
        and db_cluster_primary_info.container.State.Health.Status == "healthy"
  retries: 30
  delay: 2

- name: Ensure WordPress DB exists on PRIMARY
  community.mysql.mysql_db:
    name: "{{ wordpress_db_name }}"
    state: present
    login_host: "{{ db_cluster_mysql_login_host_primary }}"
    login_port: "{{ db_cluster_mysql_login_port_primary }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"


- name: Ensure replication user on PRIMARY
  community.mysql.mysql_user:
    name: "{{ db_cluster_repl_user }}"
    host: "%"
    password: "{{ db_cluster_repl_password }}"
    priv: "*.*:REPLICATION SLAVE"
    state: present
    login_host: "{{ db_cluster_mysql_login_host_primary }}"
    login_port: "{{ db_cluster_mysql_login_port_primary }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Get PRIMARY status
  community.mysql.mysql_replication:
    mode: getprimary
    login_host: "{{ db_cluster_mysql_login_host_primary }}"
    login_port: "{{ db_cluster_mysql_login_port_primary }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  register: db_cluster_master_status
  changed_when: false

- name: Ensure MASTER status present
  ansible.builtin.assert:
    that:
      - db_cluster_master_status.File is defined
      - db_cluster_master_status.Position is defined
      - (db_cluster_master_status.File | length) > 0
      - (db_cluster_master_status.Position | int) >= 0
    fail_msg: "SHOW MASTER STATUS пуст. Включи binlog и server-id на PRIMARY"

- name: Set facts from PRIMARY STATUS
  ansible.builtin.set_fact:
    db_cluster_master_log_file: "{{ db_cluster_master_status.File }}"
    db_cluster_master_log_pos: "{{ db_cluster_master_status.Position | int }}"
- name: Run MariaDB REPLICA
  community.docker.docker_container:
    name: "{{ db_replica_container }}"
    image: "{{ db_image }}"
    state: started
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    volumes:
      - "{{ db_replica_volume }}:/var/lib/mysql"
    env:
      MARIADB_ROOT_PASSWORD: "{{ db_root_password }}"
    command:
      - "--server-id=2"
      - "--relay-log=relay-bin"
      - "--read-only=ON"
      - "--skip-slave-start"
    published_ports:
      - "{{ db_cluster_replica_bind }}"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -p{{ db_root_password }} || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

- name: Wait REPLICA healthy
  community.docker.docker_container_info:
    name: "{{ db_replica_container }}"
  register: db_cluster_replica_info
  until: db_cluster_replica_info.container.State.Health.Status is defined
        and db_cluster_replica_info.container.State.Health.Status == "healthy"
  retries: 30
  delay: 2

- name: Stop replication on REPLICA if running
  community.mysql.mysql_replication:
    mode: stopreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  failed_when: false
  changed_when: false

- name: Reset replication config on REPLICA
  community.mysql.mysql_replication:
    mode: resetreplicaall
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Ensure WordPress DB exists on REPLICA
  community.mysql.mysql_db:
    name: "{{ wordpress_db_name }}"
    state: present
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
- name: Configure replication on REPLICA (CHANGE MASTER TO)
  community.mysql.mysql_replication:
    mode: changeprimary
    primary_host: "{{ db_primary_container }}"
    primary_user: "{{ db_repl_user }}"
    primary_password: "{{ db_repl_password }}"
    primary_log_file: "{{ db_cluster_master_log_file }}"
    primary_log_pos: "{{ db_cluster_master_log_pos }}"
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Start replication on REPLICA
  community.mysql.mysql_replication:
    mode: startreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Ensure REPLICA read_only ON
  community.mysql.mysql_variables:
    variable: read_only
    value: "ON"
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Check REPLICA status is running
  community.mysql.mysql_replication:
    mode: getreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  register: db_cluster_replica_status

- name: Assert IO and SQL threads are running
  ansible.builtin.assert:
    that:
      - (db_cluster_replica_status.Replica_IO_Running | default(db_cluster_replica_status.Slave_IO_Running)) | string | lower == 'yes'
      - (db_cluster_replica_status.Replica_SQL_Running | default(db_cluster_replica_status.Slave_SQL_Running)) | string | lower == 'yes'

- name: Ensure legacy single DB container absent
  community.docker.docker_container:
    name: wp-db
    state: absent
    force_kill: true
  when: (db_remove_legacy_single | default(true)) | bool
