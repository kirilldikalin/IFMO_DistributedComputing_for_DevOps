- name: Ensure PyMySQL for MySQL modules
  ansible.builtin.apt:
    name: python3-pymysql
    state: present
    update_cache: true

- name: Ensure volumes
  community.docker.docker_volume:
    name: "{{ item }}"
    state: present
  loop:
    - "{{ db_primary_volume }}"
    - "{{ db_replica_volume }}"
    - "{{ wordpress_volume | default('wordpress_data') }}"

- name: Ensure config dir
  ansible.builtin.file:
    path: /opt/wordpress/config
    state: directory
    mode: '0755'

- name: Render master.cnf
  ansible.builtin.template:
    src: master.cnf.j2
    dest: /opt/wordpress/config/master.cnf
    mode: '0644'

- name: Render replica.cnf
  ansible.builtin.template:
    src: replica.cnf.j2
    dest: /opt/wordpress/config/replica.cnf
    mode: '0644'

- name: Run MySQL MASTER
  community.docker.docker_container:
    name: "{{ db_primary_container }}"
    image: "{{ db_image }}"
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    published_ports:
      - "{{ db_cluster_primary_bind }}"
    volumes:
      - "{{ db_primary_volume }}:/var/lib/mysql"
      - "/opt/wordpress/config/master.cnf:/etc/mysql/conf.d/config.cnf:ro"
    env:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ wp_db_name }}"
      MYSQL_USER: "{{ wp_db_user }}"
      MYSQL_PASSWORD: "{{ wp_db_password }}"

- name: Wait MASTER tcp ready
  ansible.builtin.wait_for:
    host: "127.0.0.1"
    port: "{{ db_cluster_primary_port | int }}"
    delay: 2
    timeout: 120

- name: Check legacy DB container presence
  community.docker.docker_container_info:
    name: "{{ legacy_db_container_name }}"
  register: db_cluster_legacy_info

- name: Stop WordPress before legacy dump
  community.docker.docker_container:
    name: "{{ wordpress_container_name }}"
    state: stopped
  when: db_cluster_legacy_info.exists | default(false)
  failed_when: false
  register: db_cluster_stop_wp

- name: Ensure backup dir
  ansible.builtin.file:
    path: /opt/wordpress/backup
    state: directory
    mode: '0755'
  when: db_cluster_legacy_info.exists | default(false)

- name: Dump legacy DB to host file
  ansible.builtin.shell: |
    set -e
    docker exec -e MYSQL_PWD={{ mysql_root_password }} {{ legacy_db_container_name }} sh -lc \
      'mysqldump -uroot --databases {{ wp_db_name }}' > /opt/wordpress/backup/wp.sql
  args:
    creates: /opt/wordpress/backup/wp.sql
  when: db_cluster_legacy_info.exists | default(false)

- name: Import dump into MASTER
  ansible.builtin.shell: |
    set -e
    MYSQL_PWD={{ mysql_root_password }} mysql -h 127.0.0.1 -P {{ db_cluster_primary_port }} -uroot < /opt/wordpress/backup/wp.sql
  when: db_cluster_legacy_info.exists | default(false)

- name: Start WordPress after migration
  community.docker.docker_container:
    name: "{{ wordpress_container_name }}"
    state: started
  when: db_cluster_legacy_info.exists | default(false)

- name: Ensure replication user on MASTER
  community.mysql.mysql_user:
    name: "{{ db_cluster_repl_user }}"
    password: "{{ db_cluster_repl_password }}"
    priv: "*.*:REPLICATION SLAVE"
    host: "%"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_primary_port }}"

- name: Get MASTER status (optional)
  community.mysql.mysql_replication:
    mode: getprimary
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_primary_port }}"
  register: db_cluster_master_status

- name: Run MySQL REPLICA
  community.docker.docker_container:
    name: "{{ db_replica_container }}"
    image: "{{ db_image }}"
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    published_ports:
      - "{{ db_cluster_replica_bind }}"
    volumes:
      - "{{ db_replica_volume }}:/var/lib/mysql"
      - "/opt/wordpress/config/replica.cnf:/etc/mysql/conf.d/config.cnf:ro"
    env:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"

- name: Wait REPLICA tcp ready
  ansible.builtin.wait_for:
    host: "127.0.0.1"
    port: "{{ db_cluster_replica_port | int }}"
    delay: 2
    timeout: 120

# Останавливаем на всякий случай, если было что-то настроено
- name: Stop replication on REPLICA
  community.mysql.mysql_replication:
    mode: stopreplica
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_replica_port }}"
  failed_when: false

- name: Reset replication on REPLICA (full)
  community.mysql.mysql_replication:
    mode: resetreplicaall
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_replica_port }}"
# Настраиваем CHANGE MASTER с GTID авто-позицией
- name: Configure REPLICA to MASTER (GTID auto-position)
  community.mysql.mysql_replication:
    mode: changeprimary
    primary_host: "{{ db_primary_container }}"
    primary_port: 3306
    primary_user: "{{ db_cluster_repl_user }}"
    primary_password: "{{ db_cluster_repl_password }}"
    primary_auto_position: 1
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_replica_port }}"

- name: Start replication on REPLICA
  community.mysql.mysql_replication:
    mode: startreplica
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_replica_port }}"

- name: Check REPLICA status
  community.mysql.mysql_replication:
    mode: getreplica
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: 127.0.0.1
    login_port: "{{ db_cluster_replica_port }}"
  register: db_cluster_replica_status
  retries: 30
  delay: 5
  until:
    - (db_cluster_replica_status.Replica_IO_Running | default(db_cluster_replica_status.Slave_IO_Running)) == 'Yes'
    - (db_cluster_replica_status.Replica_SQL_Running | default(db_cluster_replica_status.Slave_SQL_Running)) == 'Yes'
