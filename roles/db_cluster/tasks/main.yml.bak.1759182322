- name: Ensure PyMySQL for MySQL modules
  ansible.builtin.apt:
    name: python3-pymysql
    state: present
    update_cache: true

- name: Ensure primary volume
  community.docker.docker_volume:
    name: "{{ db_primary_volume }}"
    state: present

- name: Ensure replica volume
  community.docker.docker_volume:
    name: "{{ db_replica_volume }}"
    state: present

- name: Ensure config dir for MariaDB
  ansible.builtin.file:
    path: /opt/wpdb
    state: directory
    mode: '0755'

- name: Ensure secrets dir for MariaDB
  ansible.builtin.file:
    path: /opt/wpdb/secrets
    state: directory
    mode: '0700'

- name: Write mysql_root.cnf secret
  ansible.builtin.copy:
    dest: /opt/wpdb/secrets/mysql_root.cnf
    mode: '0600'
    content: |
      [client]
      user=root
      password={{ db_root_password }}

- name: Write MariaDB PRIMARY config
  ansible.builtin.copy:
    dest: /opt/wpdb/primary.cnf
    mode: '0644'
    content: |
      [mysqld]
      {% set args = db_cluster_mariadb_primary_extra_args %}
      {% if args is string %}
      {%   set args_list = args.split() %}
      {% else %}
      {%   set args_list = args %}
      {% endif %}
      {% for a in args_list %}
      {{ a | regex_replace('^--', '') }}
      {% endfor %}

- name: Write MariaDB REPLICA config
  ansible.builtin.copy:
    dest: /opt/wpdb/replica.cnf
    mode: '0644'
    content: |
      [mysqld]
      {% set args = db_cluster_mariadb_replica_extra_args %}
      {% if args is string %}
      {%   set args_list = args.split() %}
      {% else %}
      {%   set args_list = args %}
      {% endif %}
      {% for a in args_list %}
      {{ a | regex_replace('^--', '') }}
      {% endfor %}

- name: Run MariaDB PRIMARY
  community.docker.docker_container:
    name: "{{ db_primary_container }}"
    image: "{{ db_image }}"
    state: started
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    published_ports:
      - "{{ db_cluster_primary_bind }}"
    volumes:
      - "{{ db_primary_volume }}:/var/lib/mysql"
      - "/opt/wpdb/primary.cnf:/etc/mysql/conf.d/primary.cnf:ro"
      - "/opt/wpdb/secrets/mysql_root.cnf:/run/secrets/mysql_root.cnf:ro"
    env:
      MARIADB_ROOT_PASSWORD: "{{ db_root_password }}"
      MARIADB_DATABASE: "{{ wordpress_db_name }}"
      MARIADB_USER: "{{ wordpress_db_user }}"
      MARIADB_PASSWORD: "{{ wordpress_db_password }}"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin --defaults-extra-file=/run/secrets/mysql_root.cnf ping -h 127.0.0.1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

- name: Wait PRIMARY healthy
  community.docker.docker_container_info:
    name: "{{ db_primary_container }}"
  register: db_cluster_primary_info
  until: db_cluster_primary_info.container.State.Health.Status is defined and db_cluster_primary_info.container.State.Health.Status == "healthy"
  retries: 30
  delay: 2

- name: Migrate data from legacy single DB if present
  when: (db_remove_legacy_single | default(true)) | bool
  block:
    - name: Check legacy DB container
      community.docker.docker_container_info:
        name: "{{ db_container_name }}"
      register: db_cluster_legacy_db_info
      failed_when: false

    - name: Stop WordPress before migration
      community.docker.docker_container:
        name: "{{ wordpress_container_name }}"
        state: stopped
      register: db_cluster_stop_wp_result
      failed_when: db_cluster_stop_wp_result is failed and ('no such container' not in (db_cluster_stop_wp_result.msg | default('') | lower))

    - name: Stop PRIMARY before migration
      community.docker.docker_container:
        name: "{{ db_primary_container }}"
        state: stopped

    - name: Stop legacy DB
      community.docker.docker_container:
        name: "{{ db_container_name }}"
        state: stopped
      when: db_cluster_legacy_db_info.exists | default(false)

    - name: Copy datadir from legacy volume to PRIMARY volume
      community.docker.docker_container:
        name: wpdb-migration
        image: busybox:1.36
        state: started
        auto_remove: true
        detach: false
        volumes:
          - "{{ db_volume }}:/from"
          - "{{ db_primary_volume }}:/to"
        command: sh -lc "cp -a /from/. /to/"
      when: db_cluster_legacy_db_info.exists | default(false)

    - name: Start PRIMARY after migration
      community.docker.docker_container:
        name: "{{ db_primary_container }}"
        state: started

- name: Ensure replication user on PRIMARY
  community.mysql.mysql_user:
    name: "{{ db_cluster_repl_user | default('repl') }}"
    password: "{{ db_cluster_repl_password | default(vault_db_cluster_repl_password) }}"
    priv: "*.*:REPLICATION SLAVE"
    state: present
    login_host: "{{ db_cluster_mysql_login_host_primary }}"
    login_port: "{{ db_cluster_mysql_login_port_primary }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Get PRIMARY status
  community.mysql.mysql_replication:
    mode: getprimary
    login_host: "{{ db_cluster_mysql_login_host_primary }}"
    login_port: "{{ db_cluster_mysql_login_port_primary }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  register: db_cluster_primary_status

- name: Run MariaDB REPLICA
  community.docker.docker_container:
    name: "{{ db_replica_container }}"
    image: "{{ db_image }}"
    state: started
    restart_policy: always
    networks:
      - name: "{{ docker_network_name }}"
    published_ports:
      - "{{ db_cluster_replica_bind }}"
    volumes:
      - "{{ db_replica_volume }}:/var/lib/mysql"
      - "/opt/wpdb/replica.cnf:/etc/mysql/conf.d/replica.cnf:ro"
      - "/opt/wpdb/secrets/mysql_root.cnf:/run/secrets/mysql_root.cnf:ro"
    env:
      MARIADB_ROOT_PASSWORD: "{{ db_root_password }}"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin --defaults-extra-file=/run/secrets/mysql_root.cnf ping -h 127.0.0.1 || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

- name: Wait REPLICA healthy
  community.docker.docker_container_info:
    name: "{{ db_replica_container }}"
  register: db_cluster_replica_info
  until: db_cluster_replica_info.container.State.Health.Status is defined and db_cluster_replica_info.container.State.Health.Status == "healthy"
  retries: 30
  delay: 2

- name: Grant remote root on PRIMARY
  community.docker.docker_container_exec:
    container: "{{ db_primary_container }}"
    command: |
      sh -lc 'mysql --defaults-extra-file=/run/secrets/mysql_root.cnf -e "
        CREATE USER IF NOT EXISTS '''root'''@'''%''' IDENTIFIED BY '''{{ db_root_password }}''';
        GRANT ALL PRIVILEGES ON *.* TO '''root'''@'''%''' WITH GRANT OPTION;
        FLUSH PRIVILEGES;
      "'
- name: Grant remote root on REPLICA
  community.docker.docker_container_exec:
    container: "{{ db_replica_container }}"
    command: |
      sh -lc 'mysql --defaults-extra-file=/run/secrets/mysql_root.cnf -e "
        CREATE USER IF NOT EXISTS '''root'''@'''%''' IDENTIFIED BY '''{{ db_root_password }}''';
        GRANT ALL PRIVILEGES ON *.* TO '''root'''@'''%''' WITH GRANT OPTION;
        FLUSH PRIVILEGES;
      "'
- name: Stop replication on REPLICA if running
  community.mysql.mysql_replication:
    mode: stopreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  register: db_cluster_stop_repl_result
  failed_when: db_cluster_stop_repl_result is failed and ('not running' not in (db_cluster_stop_repl_result.msg | default('') | lower))

- name: Configure REPLICA to PRIMARY
  community.mysql.mysql_replication:
    mode: changemaster
    master_host: "{{ db_primary_container }}"
    master_user: "{{ db_cluster_repl_user | default('repl') }}"
    master_password: "{{ db_cluster_repl_password | default(vault_db_cluster_repl_password) }}"
    master_port: 3306
    master_log_file: "{{ db_cluster_primary_status.File | default(db_cluster_primary_status.Master_Log_File) }}"
    master_log_pos: "{{ db_cluster_primary_status.Position | default(db_cluster_primary_status.Master_Log_Pos) }}"
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Start replication on REPLICA
  community.mysql.mysql_replication:
    mode: startreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"

- name: Get REPLICA status
  community.mysql.mysql_replication:
    mode: getreplica
    login_host: "{{ db_cluster_mysql_login_host_replica }}"
    login_port: "{{ db_cluster_mysql_login_port_replica }}"
    login_user: "{{ db_cluster_mysql_login_user }}"
    login_password: "{{ db_root_password }}"
  register: db_cluster_replica_status

- name: Assert IO and SQL threads are running
  ansible.builtin.assert:
    that:
      - (db_cluster_replica_status.Replica_IO_Running | default(db_cluster_replica_status.Slave_IO_Running)) | string | lower == 'yes'
      - (db_cluster_replica_status.Replica_SQL_Running | default(db_cluster_replica_status.Slave_SQL_Running)) | string | lower == 'yes'

- name: Ensure legacy single DB container absent
  community.docker.docker_container:
    name: "{{ db_container_name }}"
    state: absent
    force_kill: true
  when: (db_remove_legacy_single | default(true)) | bool
