version: "3.9"

services:
  db_master:
    image: "{{ mysql_image }}"
    container_name: db_master
    restart: always
    command: [
      "--server-id=1",
      "--log-bin=mysql-bin",
      "--binlog-format=ROW",
      "--gtid-mode=OFF",
      "--enforce-gtid-consistency=OFF"
    ]
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_db_name }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ mysql_password }}"
    volumes:
      - master_data:/var/lib/mysql
    networks:
      - wp_net
    ports:
      - "127.0.0.1:{{ mysql_master_port_host }}:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-p{{ mysql_root_password }}"]
      interval: 10s
      timeout: 5s
      retries: 30

{% if enable_replication | bool %}
  db_slave:
    image: "{{ mysql_image }}"
    container_name: db_slave
    restart: always
    command: [
      "--server-id=2",
      "--relay-log=relay-bin",
      "--read-only=ON",
      "--binlog-format=ROW"
    ]
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_db_name }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ mysql_password }}"
    volumes:
      - slave_data:/var/lib/mysql
    networks:
      - wp_net
    ports:
      - "127.0.0.1:{{ mysql_slave_port_host }}:3306"
    depends_on:
      - db_master
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-p{{ mysql_root_password }}"]
      interval: 10s
      timeout: 5s
      retries: 60

{% endif %}
  wordpress:
    image: "{{ wordpress_image }}"
    container_name: wordpress
    restart: always
    depends_on:
      - db_master
    environment:
      WORDPRESS_DB_HOST: "db_master:3306"
      WORDPRESS_DB_USER: "{{ mysql_user }}"
      WORDPRESS_DB_PASSWORD: "{{ mysql_password }}"
      WORDPRESS_DB_NAME: "{{ mysql_db_name }}"
    ports:
      - "0.0.0.0:{{ wp_http_port }}:80"
    networks:
      - wp_net

{% if enable_monitoring | bool %}
  mysqld_exporter_master:
    image: prom/mysqld-exporter:latest
    container_name: mysqld_exporter_master
    restart: always
    command:
      - "--config.my-cnf=/etc/mysqld_exporter/.my.cnf"
      - "--collect.global_status"
      - "--collect.slave_status"
    volumes:
      - "{{ project_dir }}/monitoring/mysqld_exporter_master.cnf:/etc/mysqld_exporter/.my.cnf:ro"
    networks:
      - wp_net
    depends_on:
      - db_master

{%   if enable_replication | bool %}
  mysqld_exporter_slave:
    image: prom/mysqld-exporter:latest
    container_name: mysqld_exporter_slave
    restart: always
    command:
      - "--config.my-cnf=/etc/mysqld_exporter/.my.cnf"
      - "--collect.global_status"
      - "--collect.slave_status"
    volumes:
      - "{{ project_dir }}/monitoring/mysqld_exporter_slave.cnf:/etc/mysqld_exporter/.my.cnf:ro"
    networks:
      - wp_net
    depends_on:
      - db_slave

{%   endif %}
  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    restart: always
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ prometheus_retention }}"
    volumes:
      - "{{ project_dir }}/monitoring/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"
      - prometheus_data:/prometheus
    ports:
      - "0.0.0.0:{{ prometheus_port }}:9090"
    networks:
      - wp_net
    depends_on:
      - mysqld_exporter_master
{%   if enable_replication | bool %}
      - mysqld_exporter_slave
{%   endif %}

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    restart: always
    environment:
      GF_SECURITY_ADMIN_USER: "{{ grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
    ports:
      - "0.0.0.0:{{ grafana_port }}:3000"
    volumes:
      - grafana_data:/var/lib/grafana
      - "{{ project_dir }}/monitoring/grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro"
      - "{{ project_dir }}/monitoring/grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro"
      - "{{ project_dir }}/monitoring/grafana/dashboards:/var/lib/grafana/dashboards:ro"
    networks:
      - wp_net
    depends_on:
      - prometheus

{% endif %}
networks:
  wp_net:

volumes:
  master_data:
{% if enable_replication | bool %}
  slave_data:
{% endif %}
{% if enable_monitoring | bool %}
  prometheus_data:
  grafana_data:
{% endif %}
